# 服务端口
APP_PORT=8080

# 大模型配置（可选，不配置则使用本地bge-small-zh-v1.5）
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL_NAME=qwen2.5:7b-instruct

# 嵌入模型配置
# 未配置大模型时，默认使用本地 bge-small-zh-v1.5 离线模型
# EMBEDDING_MODEL=bge-small-zh-v1.5
# EMBEDDING_API_BASE=http://localhost:11434
# EMBEDDING_API_KEY=

# 向量数据库配置
CHROMA_DB_PATH=./chroma_db
OLLAMA_API_BASE=http://localhost:11434

# 文档处理配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
TEMPERATURE=0.7

# 本地模型配置（当使用离线模型时）
USE_LOCAL_EMBEDDING=true
LOCAL_MODEL_PATH=./backend/models/bge-small-zh-v1.5
